{ "initial": "loading",
  "states": {
    "loading": { "enter": [ { "fetch": "/content/run/snapshot.json", "ok": "run.loaded", "err": "run.failed" } ],
                 "run.loaded": "ready", "run.failed": "error" },
    "ready": {
      "enter": [ { "stream": "/content/run/events.json", "ok": "run.event", "err": "run.streamFailed" } ],
      "run.event": "ready", "run.streamFailed": "ready",
      "run.loaded": "ready", "run.failed": "ready",
      "btn-pause.click": "ready", "btn-resume.click": "ready", "btn-cancel.click": "ready",
      "action.done": "ready", "action.failed": "ready",
      "steps.click": "ready", "steps.scroll": "ready",
      "btn-view-records.click": "ready", "btn-view-graph.click": "ready",
      "btn-refresh.click": "loading", "btn-theme.click": "ready",
      "nav-dashboard.click": "ready", "nav-pipelines.click": "ready", "nav-graph.click": "ready",
      "nav-records.click": "ready", "nav-issues.click": "ready", "nav-settings.click": "ready" },
    "error": { "btn-retry.click": "loading" } } }
